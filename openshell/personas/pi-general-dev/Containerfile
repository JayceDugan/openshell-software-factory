# PERSONA layer: pi-general-dev  (harness: pi, role: general-dev)
# Build context is project/ (see build.sh). Build via ./build.sh pi-general-dev.

FROM openshell-pi-harness:local

# Harness image ends as USER sandbox; assembly + chown below need root.
USER root

# AGENTS.md = shared house rules + one shared role file. Role text is harness-neutral,
# so every harness reads the identical instructions.
COPY shared/instructions/house-rules.md shared/instructions/roles/general-dev.md /tmp/assemble/
RUN mkdir -p /sandbox/agent \
	&& cat /tmp/assemble/house-rules.md /tmp/assemble/general-dev.md > /sandbox/agent/AGENTS.md \
	&& rm -rf /tmp/assemble

# Harness-specific config payload (the only part that cannot be shared across harnesses).
COPY personas/pi-general-dev/payload/ /sandbox/agent/

# After the payload copy: `pi install` rewrites settings.json, so it must come last.
RUN pi install npm:@juicesharp/rpiv-ask-user-question
# Langfuse tracing (sessions, LLM calls, tool calls). Keys come from the `langfuse` provider;
# the agent wrappers point LANGFUSE_BASE_URL at the local instance.
RUN pi install npm:pi-langfuse

RUN chown -R sandbox:sandbox /sandbox/agent

USER sandbox
WORKDIR /sandbox/work
