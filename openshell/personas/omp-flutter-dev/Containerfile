# PERSONA layer: omp-flutter-dev  (harness: omp, role: flutter-dev)
# Build context is project/ (see build.sh). Build via ./build.sh omp-flutter-dev.

FROM openshell-omp-harness:local

# Harness image ends as USER sandbox; assembly + chown below need root.
USER root

# AGENTS.md = shared house rules + one shared role file. Role text is harness-neutral,
# so pi-flutter-dev and omp-flutter-dev read the identical instructions.
COPY shared/instructions/house-rules.md shared/instructions/roles/flutter-dev.md /tmp/assemble/
RUN mkdir -p /sandbox/agent \
	&& cat /tmp/assemble/house-rules.md /tmp/assemble/flutter-dev.md > /sandbox/agent/AGENTS.md \
	&& rm -rf /tmp/assemble

# Harness-specific config payload (the only part that cannot be shared across harnesses).
COPY personas/omp-flutter-dev/payload/ /sandbox/agent/

# Harness-neutral skills: pi and omp both scan <agent-dir>/skills for SKILL.md dirs.
COPY shared/skills/ /sandbox/agent/skills/

RUN chown -R sandbox:sandbox /sandbox/agent

USER sandbox
WORKDIR /sandbox/work
