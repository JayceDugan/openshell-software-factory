# DRAFT - not applied (providers/Makefile only globs provider-*.yaml). Rename to
# providers/provider-github.yaml once the host/port/binary list is confirmed for your setup.
# Needed before pi-pr-reviewer can fetch PRs/diffs itself; today it can only review a
# repository that launch.sh bind-mounts read-only.
id: github
resource_version: 2
display_name: GitHub
description: GitHub REST API (pull requests, diffs, reviews)
category: data
inference_capable: false
credentials:
  - name: token
    description: GitHub token used for REST reads
    env_vars:
      - GITHUB_TOKEN
    required: true
    auth_style: bearer
    header_name: authorization
discovery:
  credentials:
    - token
endpoints:
  - host: api.github.com
    port: 443
    protocol: rest
    access: read-only
    enforcement: enforce
  # git clone/fetch of the repo itself; drop if you only ever bind-mount the working copy.
  - host: github.com
    port: 443
    protocol: rest
    access: read-only
    enforcement: enforce
binaries: [/usr/bin/git, /usr/bin/curl, /usr/local/bin/curl, /usr/bin/node, /usr/local/bin/node]
