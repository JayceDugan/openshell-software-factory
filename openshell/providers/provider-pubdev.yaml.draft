# DRAFT - not applied. Only needed if a Flutter persona actually runs `dart pub get` /
# `flutter pub get` inside the sandbox (current personas are instruction-only, no SDK).
id: pubdev
resource_version: 2
display_name: pub.dev
description: Dart/Flutter package registry and API
category: data
inference_capable: false
endpoints:
  - host: pub.dev
    port: 443
    protocol: rest
    access: read-only
    enforcement: enforce
  - host: storage.googleapis.com
    port: 443
    protocol: rest
    access: read-only
    enforcement: enforce
binaries: [/usr/bin/dart, /usr/local/bin/dart, /usr/bin/flutter, /usr/local/bin/flutter]
