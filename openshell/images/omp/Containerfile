# HARNESS layer: omp (can1357/oh-my-pi, https://omp.sh). No persona/config here - personas add it.
#
# Build context is project/ (see build.sh), so paths are repo-relative.
#   podman build -t openshell-omp-harness:local -f images/omp/Containerfile .
#
# Installed with the official installer (https://omp.sh/install) in --binary mode, pinned to a
# release tag. The installer itself does no checksum check, so the binary is verified against the
# per-arch sha256 digests GitHub publishes for that release. Bump OMP_VERSION and both digests
# together (`curl -s https://api.github.com/repos/can1357/oh-my-pi/releases/tags/<tag>` -> assets[].digest).

ARG BASE_IMAGE=ghcr.io/nvidia/openshell-community/sandboxes/base:latest
FROM ${BASE_IMAGE}

ARG OMP_VERSION=v18.8.6
ARG OMP_SHA256_ARM64=a6bf1405877a739965586fcf973136f72078d2e6dc288905fab08588469c13cf
ARG OMP_SHA256_X64=877acdc48384b80fe4c083b1e610433d28922dd9fccde9ea430aaace8765b19b

ENV HOME=/sandbox

# Same single writable agent-config path as every other harness, so policies/ stay
# harness-agnostic. omp honors PI_CODING_AGENT_DIR for the DEFAULT profile only
# (docs/settings.md) -> never launch these personas with --profile <name>.
ENV PI_CODING_AGENT_DIR=/sandbox/agent

# omp also writes OUTSIDE the agent dir, to its config root ($HOME/.omp): extracted native
# addon (natives/), logs/, run/. Without this, read-only-$HOME policies (review.yaml) crash at
# startup with "Failed to load pi_natives native addon". PI_CONFIG_DIR is joined onto $HOME
# (packages/utils/src/dirs.ts), so this relocates the root to /sandbox/agent/.omp.
ENV PI_CONFIG_DIR=agent/.omp

# Headless/sandbox hygiene:
#   OMP_SKIP_SETUP     no first-run setup wizard
#   PI_AUTO_QA=0       no tool-issue reports pushed to qa.omp.sh
#   OTEL_SDK_DISABLED  no OpenTelemetry export
#   PI_NO_PTY=1        bash tool without a PTY (no TTY inside headless sandboxes)
ENV OMP_SKIP_SETUP=1 \
	PI_AUTO_QA=0 \
	OTEL_SDK_DISABLED=true \
	PI_NO_PTY=1

USER root

RUN apt-get update \
	&& apt-get install -y --no-install-recommends bash ca-certificates fd-find git ripgrep vim curl jq \
	&& ln -sf /usr/bin/fdfind /usr/local/bin/fd \
	&& rm -rf /var/lib/apt/lists/*

# Installer runs `omp --version` as its own smoke test (inside this build container).
RUN curl -fsSL https://omp.sh/install | PI_INSTALL_DIR=/usr/local/bin sh -s -- --binary --ref "${OMP_VERSION}" \
	&& case "$(uname -m)" in \
		aarch64|arm64) want="${OMP_SHA256_ARM64}" ;; \
		x86_64|amd64)  want="${OMP_SHA256_X64}" ;; \
		*) echo "unsupported arch $(uname -m)" >&2; exit 1 ;; \
	esac \
	&& echo "${want}  /usr/local/bin/omp" | sha256sum -c -

# The compiled binary extracts its embedded Rust addon on first run, to ~/.omp/natives by
# default; PI_NATIVES_DIR overrides that (packages/natives/native/loader-state.js, which
# ignores PI_CONFIG_DIR). Extract once at build time into /usr (read-only under every policy)
# so sandboxes never need to write it.
ENV PI_NATIVES_DIR=/usr/local/lib/omp/natives
RUN mkdir -p "${PI_NATIVES_DIR}" \
	&& HOME=/tmp/omp-build omp config path >/dev/null \
	&& test -n "$(find "${PI_NATIVES_DIR}" -name 'pi_natives.*.node')" \
	&& chmod -R a+rX,go-w "${PI_NATIVES_DIR}" \
	&& rm -rf /tmp/omp-build

RUN mkdir -p /sandbox/agent /sandbox/work \
	&& chown -R sandbox:sandbox /sandbox/agent /sandbox/work

USER sandbox
WORKDIR /sandbox/work
